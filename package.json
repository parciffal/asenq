{
  "name": "asenq",
  "version": "0.1.0",
  "description": "Cross-harness messenger for Claude Code, OpenCode and omp sessions on one machine",
  "license": "MIT",
  "type": "module",
  "bin": {
    "asenq": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"dist/test/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^22"
  }
}
