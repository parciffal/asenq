{
  "name": "asenq",
  "version": "0.1.0",
  "description": "Cross-harness messenger for Claude Code, OpenCode and omp sessions on one machine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parciffal/asenq.git"
  },
  "homepage": "https://github.com/parciffal/asenq#readme",
  "bugs": {
    "url": "https://github.com/parciffal/asenq/issues"
  },
  "keywords": [
    "claude-code",
    "opencode",
    "omp",
    "mcp",
    "agents",
    "messaging",
    "cli"
  ],
  "type": "module",
  "bin": {
    "asenq": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist/src",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"dist/test/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "terminal-kit": "^3.1.4",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/terminal-kit": "^2.5.7",
    "typescript": "^5"
  }
}
