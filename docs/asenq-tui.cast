[4.0103, "o", "\u2502\u001b[0m\u001b[8;1H\u001b[36m\u2502\u001b[0m\u001b[2mRECONNECTING\u001b[0m             \u001b[0m\u001b[36m\u2502\u001b[0m \u001b[0m\u001b[2;90m\u2502\u001b[0m                                                                                \u001b[0m\u001b[2;90m\u2502\u001b[0m\u001b[9;1H\u001b[36m\u2502\u001b[0m\u001b[1;36m  \u001b[0m\u001b[33m\u25cc \u001b[0mold-qa        \u001b[0m\u001b[2moc \u001b[0m \u001b[0m\u001b[1;7mwrk\u001b[0m\u001b[36m\u2502\u001b[0m \u001b[0m\u001b[2;90m\u2502\u001b[0m                                                                                \u001b[0m\u001b[2;90m\u2502\u001b[0m\u001b[10;1H\u001b[36m\u2502\u001b[0m\u001b[1;36m  \u001b[0m\u001b[2m\u25be archive 1\u001b[0m            \u001b[0m\u001b[36m\u2502\u001b[0m \u001b[0m\u001b[2;90m\u2502\u001b[0m                                                                                \u001b[0m\u001b[2;90m\u2502\u001b[0m\u001b[12;1H\u001b[36m\u2502\u001b[0m                         \u001b[0m\u001b[36m\u2502\u001b[0m \u001b[0m\u001b[2;90m\u2502\u001b[0m                                                                                \u001b[0m\u001b[2;90m\u2502\u001b[0m\u001b[13;1H\u001b[36m\u2502\u001b[0m                         \u001b[0m\u001b[36m\u2502\u001b[0m \u001b[0m\u001b[2;90m\u2502\u001b[0m                                                                                \u001b[0m\u001b[2;90m\u2502\u001b[0m\u001b[27;1H\u001b[36m\u2502\u001b[0m                         \u001b[0m\u001b[36m\u2502\u001b[0m "]
